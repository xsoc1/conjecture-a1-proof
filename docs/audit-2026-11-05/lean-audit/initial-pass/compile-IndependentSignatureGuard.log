theorem ConjectureA1.vector_two_cancel.{u_1, u_2} : ∀ {K : Type u_1} {V : Type u_2} [inst : Field K] [CharZero K]
  [inst_2 : AddCommGroup V] [Module K V] (v : V), v + v = 0 → v = 0 :=
fun {K} {V} [Field K] [CharZero K] [AddCommGroup V] [Module K V] v h =>
  have h' := Eq.mpr (id (congrFun' (congrArg Eq (two_smul K v)) 0)) h;
  have h'' := congrArg (fun w => 2⁻¹ • w) h';
