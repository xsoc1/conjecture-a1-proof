    (congr
      (congrArg Eq
        (Eq.trans (smul_smul 2⁻¹ 2 v)
          (Eq.trans
            (congrFun'
              (congrArg HSMul.hSMul
                (inv_mul_cancel₀
                  (Mathlib.Meta.NormNum.isNat_eq_false (Mathlib.Meta.NormNum.isNat_ofNat K (Eq.refl 2))
                    (Mathlib.Meta.NormNum.isNat_ofNat K Nat.cast_zero) (Eq.refl false))))
              v)
            (one_smul K v))))
      (smul_zero 2⁻¹))
    h''
