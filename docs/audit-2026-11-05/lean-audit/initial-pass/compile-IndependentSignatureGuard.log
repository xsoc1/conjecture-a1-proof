@[defeq] theorem ConjectureA1.ad_def.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  ConjectureA1.ad x y = x * y - y * x :=
fun {R} [Ring R] x y => rfl
theorem ConjectureA1.ad_add.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y z : R),
  ConjectureA1.ad x (y + z) = ConjectureA1.ad x y + ConjectureA1.ad x z :=
fun {R} [Ring R] x y z =>
  id
    (Eq.mpr (id (congrArg (fun _a => _a - (y + z) * x = x * y - y * x + (x * z - z * x)) (mul_add x y z)))
      (Eq.mpr (id (congrArg (fun _a => x * y + x * z - _a = x * y - y * x + (x * z - z * x)) (add_mul y z x)))
        (ConjectureA1.ad_add._abel_1_1 x y z)))
theorem ConjectureA1.ad_zero.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x : R), ConjectureA1.ad x 0 = 0 :=
fun {R} [Ring R] x =>
  id
    (of_eq_true
      (Eq.trans
        (congrFun' (congrArg Eq (Eq.trans (congr (congrArg HSub.hSub (mul_zero x)) (zero_mul x)) (sub_self 0))) 0)
        (eq_self 0)))
theorem ConjectureA1.ad_neg.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  ConjectureA1.ad x (-y) = -ConjectureA1.ad x y :=
fun {R} [Ring R] x y =>
  id
    (Eq.mpr
      (id
        (congr
          (congrArg Eq
            (Eq.trans (congr (congrArg HSub.hSub (mul_neg x y)) (neg_mul y x)) (sub_eq_add_neg (-(x * y)) (-(y * x)))))
          (congrArg Neg.neg (sub_eq_add_neg (x * y) (y * x)))))
      (ConjectureA1.ad_neg._abel_1_1 x y))
theorem ConjectureA1.ad_one.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x : R), ConjectureA1.ad x 1 = 0 :=
fun {R} [Ring R] x =>
  id
    (of_eq_true
      (Eq.trans (congrFun' (congrArg Eq (Eq.trans (congr (congrArg HSub.hSub (mul_one x)) (one_mul x)) (sub_self x))) 0)
        (eq_self 0)))
theorem ConjectureA1.ad_mul.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y z : R),
  ConjectureA1.ad x (y * z) = ConjectureA1.ad x y * z + y * ConjectureA1.ad x z :=
fun {R} [Ring R] x y z =>
  id
    (Eq.mpr
      (id
        (congr
          (congrArg Eq
            (Eq.trans (congrArg (HSub.hSub (x * (y * z))) (mul_assoc y z x))
              (sub_eq_add_neg (x * (y * z)) (y * (z * x)))))
          (congr
            (congrArg HAdd.hAdd
              (Eq.trans
                (Eq.trans (congrFun' (congrArg HMul.hMul (sub_eq_add_neg (x * y) (y * x))) z)
                  (add_mul (x * y) (-(y * x)) z))
                (congr (congrArg HAdd.hAdd (mul_assoc x y z))
                  (Eq.trans (neg_mul (y * x) z) (congrArg Neg.neg (mul_assoc y x z))))))
            (Eq.trans
              (Eq.trans (congrArg (HMul.hMul y) (sub_eq_add_neg (x * z) (z * x))) (mul_add y (x * z) (-(z * x))))
              (congrArg (HAdd.hAdd (y * (x * z))) (mul_neg y (z * x)))))))
      (ConjectureA1.ad_mul._abel_1_1 x y z))
theorem ConjectureA1.ad_pow_succ.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x w : R) (r : ℕ),
  x * (w * x ^ r) = w * x ^ (r + 1) + ConjectureA1.ad x w * x ^ r :=
fun {R} [Ring R] x w r =>
  id
    (Eq.mpr (id (congrArg (fun _a => x * (w * x ^ r) = w * _a + (x * w - w * x) * x ^ r) (pow_succ' x r)))
      (Eq.mpr
        (id
          (congrArg (Eq (x * (w * x ^ r)))
            (congrArg (HAdd.hAdd (w * (x * x ^ r)))
              (Eq.trans
                (Eq.trans (congrFun' (congrArg HMul.hMul (sub_eq_add_neg (x * w) (w * x))) (x ^ r))
                  (add_mul (x * w) (-(w * x)) (x ^ r)))
                (congr (congrArg HAdd.hAdd (mul_assoc x w (x ^ r)))
                  (Eq.trans (neg_mul (w * x) (x ^ r)) (congrArg Neg.neg (mul_assoc w x (x ^ r)))))))))
        (ConjectureA1.ad_pow_succ._abel_1_1 x w r)))
theorem ConjectureA1.ad_swap.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  ConjectureA1.ad y x = -ConjectureA1.ad x y :=
fun {R} [Ring R] x y =>
  id
    (Eq.mpr
      (id (congr (congrArg Eq (sub_eq_add_neg (y * x) (x * y))) (congrArg Neg.neg (sub_eq_add_neg (x * y) (y * x)))))
      (ConjectureA1.ad_swap._abel_1_1 x y))
theorem ConjectureA1.ad_pow_of_commute.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  Commute y (ConjectureA1.ad x y) →
    ∀ (n : ℕ), ConjectureA1.ad x (y ^ (n + 1)) = (n + 1) • (y ^ n * ConjectureA1.ad x y) :=
fun {R} [Ring R] x y hy n =>
  Nat.recAux
    (of_eq_true
      (Eq.trans
        (congr (congrArg Eq (congrArg (ConjectureA1.ad x) (Eq.trans (congrArg (HPow.hPow y) (zero_add 1)) (pow_one y))))
          (Eq.trans
            (congr (congrArg HSMul.hSMul (zero_add 1))
              (Eq.trans (congrFun' (congrArg HMul.hMul (pow_zero y)) (x * y - y * x)) (one_mul (x * y - y * x))))
            (one_smul ℕ (x * y - y * x))))
        (eq_self (x * y - y * x))))
    (fun n ih =>
      Eq.mpr
        (id
          (congrArg (fun _a => ConjectureA1.ad x _a = (n + 1 + 1) • (y ^ (n + 1) * ConjectureA1.ad x y))
            (pow_succ y (n + 1))))
        (Eq.mpr
          (id
            (congrArg (fun _a => _a = (n + 1 + 1) • (y ^ (n + 1) * ConjectureA1.ad x y))
              (ConjectureA1.ad_mul x (y ^ (n + 1)) y)))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  _a * y + y ^ (n + 1) * ConjectureA1.ad x y = (n + 1 + 1) • (y ^ (n + 1) * ConjectureA1.ad x y))
                ih))
            (Trans.trans
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      _a + y ^ (n + 1) * ConjectureA1.ad x y =
                        (n + 1) • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y)
                    (smul_mul_assoc (n + 1) (y ^ n * ConjectureA1.ad x y) y)))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        (n + 1) • _a + y ^ (n + 1) * ConjectureA1.ad x y =
                          (n + 1) • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y)
                      (mul_assoc (y ^ n) (ConjectureA1.ad x y) y)))
                  (Eq.mpr
                    (id
                      (congrArg
                        (fun _a =>
                          (n + 1) • (y ^ n * _a) + y ^ (n + 1) * ConjectureA1.ad x y =
                            (n + 1) • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y)
                        (Eq.symm (Commute.eq hy))))
                    (Eq.mpr
                      (id
                        (congrArg
                          (fun _a =>
                            (n + 1) • _a + y ^ (n + 1) * ConjectureA1.ad x y =
                              (n + 1) • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y)
                          (Eq.symm (mul_assoc (y ^ n) y (ConjectureA1.ad x y)))))
                      (Eq.mpr
                        (id
                          (congrArg
                            (fun _a =>
                              (n + 1) • (_a * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y =
                                (n + 1) • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y)
                            (Eq.symm (pow_succ y n))))
                        (Eq.refl
                          ((n + 1) • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y)))))))
              (of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq
                      (congrFun'
                        (congrArg HAdd.hAdd
                          (Eq.trans (add_nsmul (y ^ (n + 1) * ConjectureA1.ad x y) n 1)
                            (congrArg (HAdd.hAdd (n • (y ^ (n + 1) * ConjectureA1.ad x y)))
                              (one_nsmul (y ^ (n + 1) * ConjectureA1.ad x y)))))
                        (y ^ (n + 1) * ConjectureA1.ad x y)))
                    (Eq.trans (add_nsmul (y ^ (n + 1) * ConjectureA1.ad x y) (n + 1) 1)
                      (congr
                        (congrArg HAdd.hAdd
                          (Eq.trans (add_nsmul (y ^ (n + 1) * ConjectureA1.ad x y) n 1)
                            (congrArg (HAdd.hAdd (n • (y ^ (n + 1) * ConjectureA1.ad x y)))
                              (one_nsmul (y ^ (n + 1) * ConjectureA1.ad x y)))))
                        (one_nsmul (y ^ (n + 1) * ConjectureA1.ad x y)))))
                  (eq_self
                    (n • (y ^ (n + 1) * ConjectureA1.ad x y) + y ^ (n + 1) * ConjectureA1.ad x y +
                      y ^ (n + 1) * ConjectureA1.ad x y))))))))
    n
theorem ConjectureA1.mul_pow_normal_order.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  Commute y (ConjectureA1.ad x y) →
    ∀ (n : ℕ), x * y ^ (n + 1) = y ^ (n + 1) * x + (n + 1) • (y ^ n * ConjectureA1.ad x y) :=
fun {R} [Ring R] x y hy n =>
  have h := ConjectureA1.ad_pow_of_commute x y hy n;
  have h' := sub_eq_iff_eq_add.mp h;
  id (Eq.mp (congrArg (Eq (x * y ^ (n + 1))) (add_comm ((n + 1) • (y ^ n * (x * y - y * x))) (y ^ (n + 1) * x))) h')
theorem ConjectureA1.ad_pow_eq.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  Commute y (ConjectureA1.ad x y) → ∀ (n : ℕ), ConjectureA1.ad x (y ^ n) = n • (y ^ (n - 1) * ConjectureA1.ad x y) :=
fun {R} [Ring R] x y hy n =>
  Nat.casesAuxOn (motive := fun a => n = a → ConjectureA1.ad x (y ^ n) = n • (y ^ (n - 1) * ConjectureA1.ad x y)) n
    (fun h =>
      Eq.symm h ▸
        of_eq_true
          (Eq.trans
            (congr
              (congrArg Eq
                (Eq.trans (congrArg (ConjectureA1.ad x) (pow_zero y))
                  (Eq.trans (congr (congrArg HSub.hSub (mul_one x)) (one_mul x)) (sub_self x))))
              (Eq.trans
                (congrArg (HSMul.hSMul 0)
                  (Eq.trans
                    (congrFun' (congrArg HMul.hMul (Eq.trans (congrArg (HPow.hPow y) (zero_tsub 1)) (pow_zero y)))
                      (x * y - y * x))
                    (one_mul (x * y - y * x))))
                (zero_nsmul (x * y - y * x))))
            (eq_self 0)))
    (fun n_1 h =>
      Eq.symm h ▸
        Eq.mpr
          (id
            (congrArg (Eq (ConjectureA1.ad x (y ^ (n_1 + 1))))
              (congrArg (HSMul.hSMul (n_1 + 1))
                (congrFun' (congrArg HMul.hMul (congrArg (HPow.hPow y) (Nat.add_sub_cancel n_1 1)))
                  (ConjectureA1.ad x y)))))
          (ConjectureA1.ad_pow_of_commute x y hy n_1))
    (Eq.refl n)
theorem ConjectureA1.pow_mul_normal_order.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  Commute x (ConjectureA1.ad x y) →
    ∀ (n : ℕ), x ^ (n + 1) * y = y * x ^ (n + 1) + (n + 1) • (x ^ n * ConjectureA1.ad x y) :=
fun {R} [Ring R] x y hx n =>
  have hx' := Eq.mpr (id (congrArg (fun _a => Commute x _a) (ConjectureA1.ad_swap x y))) (Commute.neg_right hx);
  have h := ConjectureA1.mul_pow_normal_order y x hx' n;
  have h' :=
    Eq.mpr
      (id
        (congrArg (Eq (y * x ^ (n + 1))) (sub_eq_add_neg (x ^ (n + 1) * y) ((n + 1) • (x ^ n * ConjectureA1.ad x y)))))
      (Eq.mp
        (congrArg (fun _a => y * x ^ (n + 1) = x ^ (n + 1) * y + _a) (smul_neg (n + 1) (x ^ n * ConjectureA1.ad x y)))
        (Eq.mp
          (congrArg (fun _a => y * x ^ (n + 1) = x ^ (n + 1) * y + (n + 1) • _a)
            (mul_neg (x ^ n) (ConjectureA1.ad x y)))
          (Eq.mp
            (congrArg (fun _a => y * x ^ (n + 1) = x ^ (n + 1) * y + (n + 1) • (x ^ n * _a)) (ConjectureA1.ad_swap x y))
            h)));
  Eq.symm (eq_sub_iff_add_eq.mp h')
theorem ConjectureA1.two_mul_add_pow_five.{u_1} : ∀ {R : Type u_1} [inst : Ring R] (x y : R),
  Commute x (ConjectureA1.ad x y) →
    Commute y (ConjectureA1.ad x y) →
      2 * (x + y) ^ 5 =
        (2 * (x * x * x) + 12 * (x * x * y) + -4 * (x * y * x) + 5 * (x * y * y) + 2 * (y * x * x) + 20 * (y * x * y) +
                -10 * (y * y * x) +
              5 * (y * y * y)) *
            x ^ 2 +
          (5 * (x * x * x) + 2 * (x * x * y) + -4 * (x * y * x) + 2 * (x * y * y) + 17 * (y * x * x) +
                  -4 * (y * x * y) +
                12 * (y * y * x) +
              2 * (y * y * y)) *
            y ^ 2 :=
fun {R} [⋯] x y hX hY =>
  have hRX := sub_eq_zero.mpr (Commute.eq hX);
  have hRY := sub_eq_zero.mpr (Commute.eq hY);
  have cert :=
    id
      (Eq.mpr
        (id
          (congr
            (congrArg Eq
              (Eq.trans
                (congrArg (HMul.hMul 2)
                  (Eq.trans (pow_succ (x + y) 4)
                    (Eq.trans
                      (Eq.trans
                        (congrFun'
                          (congrArg HMul.hMul
                            (Eq.trans (pow_succ (x + y) 3)
                              (Eq.trans
                                (Eq.trans
                                  (congrFun'
                                    (congrArg HMul.hMul
                                      (Eq.trans (pow_succ (x + y) 2)
                                        (Eq.trans
                                          (Eq.trans
                                            (congrFun'
                                              (congrArg HMul.hMul
                                                (Eq.trans (pow_succ (x + y) 1)
                                                  (Eq.trans
                                                    (Eq.trans
                                                      (congrFun'
                                                        (congrArg HMul.hMul
                                                          (Eq.trans (pow_succ (x + y) 0)
                                                            (Eq.trans
                                                              (Eq.trans
                                                                (congrFun' (congrArg HMul.hMul (pow_zero (x + y)))
                                                                  (x + y))
                                                                (mul_add 1 x y))
                                                              (congr (congrArg HAdd.hAdd (one_mul x)) (one_mul y)))))
                                                        (x + y))
                                                      (mul_add (x + y) x y))
                                                    (congr (congrArg HAdd.hAdd (add_mul x y x)) (add_mul x y y)))))
                                              (x + y))
                                            (mul_add (x * x + y * x + (x * y + y * y)) x y))
                                          (congr
                                            (congrArg HAdd.hAdd
                                              (Eq.trans (add_mul (x * x + y * x) (x * y + y * y) x)
                                                (congr
                                                  (congrArg HAdd.hAdd
                                                    (Eq.trans (add_mul (x * x) (y * x) x)
                                                      (congr (congrArg HAdd.hAdd (mul_assoc x x x)) (mul_assoc y x x))))
                                                  (Eq.trans (add_mul (x * y) (y * y) x)
                                                    (congr (congrArg HAdd.hAdd (mul_assoc x y x)) (mul_assoc y y x))))))
                                            (Eq.trans (add_mul (x * x + y * x) (x * y + y * y) y)
                                              (congr
                                                (congrArg HAdd.hAdd
                                                  (Eq.trans (add_mul (x * x) (y * x) y)
                                                    (congr (congrArg HAdd.hAdd (mul_assoc x x y)) (mul_assoc y x y))))
                                                (Eq.trans (add_mul (x * y) (y * y) y)
                                                  (congr (congrArg HAdd.hAdd (mul_assoc x y y))
                                                    (mul_assoc y y y)))))))))
                                    (x + y))
                                  (mul_add
                                    (x * (x * x) + y * (x * x) + (x * (y * x) + y * (y * x)) +
                                      (x * (x * y) + y * (x * y) + (x * (y * y) + y * (y * y))))
                                    x y))
                                (congr
                                  (congrArg HAdd.hAdd
                                    (Eq.trans
                                      (add_mul (x * (x * x) + y * (x * x) + (x * (y * x) + y * (y * x)))
                                        (x * (x * y) + y * (x * y) + (x * (y * y) + y * (y * y))) x)
                                      (congr
                                        (congrArg HAdd.hAdd
                                          (Eq.trans (add_mul (x * (x * x) + y * (x * x)) (x * (y * x) + y * (y * x)) x)
                                            (congr
                                              (congrArg HAdd.hAdd
                                                (Eq.trans (add_mul (x * (x * x)) (y * (x * x)) x)
                                                  (congr
                                                    (congrArg HAdd.hAdd
                                                      (Eq.trans (mul_assoc x (x * x) x)
                                                        (congrArg (HMul.hMul x) (mul_assoc x x x))))
                                                    (Eq.trans (mul_assoc y (x * x) x)
                                                      (congrArg (HMul.hMul y) (mul_assoc x x x))))))
                                              (Eq.trans (add_mul (x * (y * x)) (y * (y * x)) x)
                                                (congr
                                                  (congrArg HAdd.hAdd
                                                    (Eq.trans (mul_assoc x (y * x) x)
                                                      (congrArg (HMul.hMul x) (mul_assoc y x x))))
                                                  (Eq.trans (mul_assoc y (y * x) x)
                                                    (congrArg (HMul.hMul y) (mul_assoc y x x))))))))
                                        (Eq.trans (add_mul (x * (x * y) + y * (x * y)) (x * (y * y) + y * (y * y)) x)
                                          (congr
                                            (congrArg HAdd.hAdd
                                              (Eq.trans (add_mul (x * (x * y)) (y * (x * y)) x)
                                                (congr
                                                  (congrArg HAdd.hAdd
                                                    (Eq.trans (mul_assoc x (x * y) x)
