                                                  (Eq.trans (mul_assoc y (x * y) x)
                                                    (congrArg (HMul.hMul y) (mul_assoc x y x))))))
                                            (Eq.trans (add_mul (x * (y * y)) (y * (y * y)) x)
                                              (congr
                                                (congrArg HAdd.hAdd
                                                  (Eq.trans (mul_assoc x (y * y) x)
                                                    (congrArg (HMul.hMul x) (mul_assoc y y x))))
                                                (Eq.trans (mul_assoc y (y * y) x)
                                                  (congrArg (HMul.hMul y) (mul_assoc y y x))))))))))
                                  (Eq.trans
                                    (add_mul (x * (x * x) + y * (x * x) + (x * (y * x) + y * (y * x)))
                                      (x * (x * y) + y * (x * y) + (x * (y * y) + y * (y * y))) y)
                                    (congr
                                      (congrArg HAdd.hAdd
                                        (Eq.trans (add_mul (x * (x * x) + y * (x * x)) (x * (y * x) + y * (y * x)) y)
                                          (congr
                                            (congrArg HAdd.hAdd
                                              (Eq.trans (add_mul (x * (x * x)) (y * (x * x)) y)
                                                (congr
                                                  (congrArg HAdd.hAdd
                                                    (Eq.trans (mul_assoc x (x * x) y)
                                                      (congrArg (HMul.hMul x) (mul_assoc x x y))))
                                                  (Eq.trans (mul_assoc y (x * x) y)
                                                    (congrArg (HMul.hMul y) (mul_assoc x x y))))))
                                            (Eq.trans (add_mul (x * (y * x)) (y * (y * x)) y)
                                              (congr
                                                (congrArg HAdd.hAdd
                                                  (Eq.trans (mul_assoc x (y * x) y)
                                                    (congrArg (HMul.hMul x) (mul_assoc y x y))))
                                                (Eq.trans (mul_assoc y (y * x) y)
                                                  (congrArg (HMul.hMul y) (mul_assoc y x y))))))))
                                      (Eq.trans (add_mul (x * (x * y) + y * (x * y)) (x * (y * y) + y * (y * y)) y)
                                        (congr
                                          (congrArg HAdd.hAdd
                                            (Eq.trans (add_mul (x * (x * y)) (y * (x * y)) y)
                                              (congr
                                                (congrArg HAdd.hAdd
                                                  (Eq.trans (mul_assoc x (x * y) y)
                                                    (congrArg (HMul.hMul x) (mul_assoc x y y))))
                                                (Eq.trans (mul_assoc y (x * y) y)
                                                  (congrArg (HMul.hMul y) (mul_assoc x y y))))))
                                          (Eq.trans (add_mul (x * (y * y)) (y * (y * y)) y)
                                            (congr
                                              (congrArg HAdd.hAdd
                                                (Eq.trans (mul_assoc x (y * y) y)
                                                  (congrArg (HMul.hMul x) (mul_assoc y y y))))
                                              (Eq.trans (mul_assoc y (y * y) y)
                                                (congrArg (HMul.hMul y) (mul_assoc y y y)))))))))))))
                          (x + y))
                        (mul_add
                          (x * (x * (x * x)) + y * (x * (x * x)) + (x * (y * (x * x)) + y * (y * (x * x))) +
                              (x * (x * (y * x)) + y * (x * (y * x)) + (x * (y * (y * x)) + y * (y * (y * x)))) +
                            (x * (x * (x * y)) + y * (x * (x * y)) + (x * (y * (x * y)) + y * (y * (x * y))) +
                              (x * (x * (y * y)) + y * (x * (y * y)) + (x * (y * (y * y)) + y * (y * (y * y))))))
                          x y))
                      (congr
